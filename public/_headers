# Response headers for static hosts that read a `_headers` file (Cloudflare Pages, Netlify).
# GitHub Pages ignores this file (it cannot set custom headers); the app works there without them.
# The app has no third-party requests, so everything can be locked to its own origin.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Built files have a hash in their name and never change.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# These must always be re-checked, or users would not get new versions.
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
